# Copy to .env. Optional entries show defaults. Never commit credentials; restart after edits.
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///./roleradar.db
# API_BASE_URL=http://localhost:8000
# CORS_ORIGINS=["http://localhost:8501"]
# LOG_LEVEL=INFO
# No key: deterministic job analysis/proposals still work; CV generation requires a key.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4.1-mini
# AI_EXPLANATIONS_ENABLED=true
# This switch disables explanations/proposal inference, NOT CV generation provider calls.
# Private source folder is read-only; prefer absolute paths.
# CV_LIBRARY_PATH=./data/cv_library
# GENERATED_CV_PATH=./data/generated_cvs
# Separate public demo; these limits do not apply to private CV/Copilot calls.
# PUBLIC_DEMO_ENABLED=false
# DEMO_MAX_CHARACTERS=20000
# DEMO_REQUESTS_PER_MINUTE=12
# DEMO_DAILY_MODEL_CALL_BUDGET=100
# DEMO_PROVIDER_TIMEOUT_SECONDS=10
# PORTFOLIO_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# TRUSTED_PROXY_CIDRS=[]
